<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Ürün Listeleme Sayfası Otomasyonları">

    <listeners>
        <listener class-name="utility.ExtentTestNGListener"/>
    </listeners>

    <test name="Ürün Listeleme Sayfası Testleri">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <packages>
            <package name="tests.mainPageTests"/>
            <package name="tests.searchTests"/>
            <package name="tests.listingPageTests"/>
            <package name="tests.productPageTests"/>
            <package name="tests.cartTests"/>
        </packages>
    </test>
</suite>
